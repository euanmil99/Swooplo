# Swooplo.com Production Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://swooplo_user:your_secure_postgres_password_here@postgres:5432/swooplo

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT and Session Secrets (Generate secure random strings)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
SESSION_SECRET=your_session_secret_here_make_it_long_and_random

# Application URLs
CLIENT_URL=https://swooplo.com
BASE_URL=https://swooplo.com
API_URL=https://api.swooplo.com

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# ClickBank Configuration
CLICKBANK_API_KEY=your_clickbank_api_key_here

# Amazon Associates Configuration
AMAZON_ASSOCIATES_TAG=your_amazon_associates_tag_here

# LocalAI Configuration (for AI features)
LOCALAI_API_KEY=your_localai_api_key_here
LOCALAI_BASE_URL=http://localai:8080

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Email Configuration (for email scraping and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here

# SSL Certificate Configuration
CERTBOT_EMAIL=your_email@domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Scraper Configuration
EMAIL_SCRAPER_RATE_LIMIT=10
EMAIL_SCRAPER_DELAY=2000
EMAIL_SCRAPER_MAX_EMAILS=1000
EMAIL_SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; Swooplo/1.0)

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Security
CORS_ORIGIN=https://swooplo.com
NODE_ENV=production

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Performance
WORKER_THREADS=4
CLUSTER_MODE=true 